   ],
   "source": [
    "import torch\n",
    "policy = torch.zeros(10, requires_grad=True)\n",
    "IOR = torch.tensor(0.5)\n",
    "t = torch.linspace(0, 1, 10)\n",
    "substrate = (policy * torch.exp(-t)).sum()\n",
    "yield_val = -(substrate - IOR * 3.0)**2 + 4.0 * IOR * (1 - IOR) - 0.05 * (policy**2).sum()\n",
    "yield_val.backward()\n",
    "print(policy.grad)"
   ]
  }
 ],
